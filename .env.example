# Copy this file to .env in the repo root and fill in the values before running
# docker compose up. Compose reads .env from the same directory as the
# docker-compose*.yml files to substitute these.
#
# LLM_MODEL selects the bookmark-enrichment model, in litellm's "provider/model" form
# (default: gemini/gemini-3.5-flash; OpenRouter adds the underlying model as a third segment,
# e.g. openrouter/anthropic/claude-sonnet-4.5). Only set the API key matching LLM_MODEL's
# provider — the backend fails fast at startup if the matching key is missing.
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
REPLICATE_API_KEY=
TOGETHERAI_API_KEY=
OPENROUTER_API_KEY=
